    <string name="onboarding_p1_title">Watch. Tap. Learn.</string>
    <string name="onboarding_p1_body">Keep the line you just heard. Tap a word in the subtitles and its card is already there — the film never leaves the screen.</string>
    <string name="onboarding_p1_hint">Tap the highlighted word</string>
    <string name="onboarding_p1_clip">You gotta have grit if you wanna make it in this town.</string>
    <string name="onboarding_p1_word">grit</string>
    <string name="onboarding_p1_ipa">/ɡrɪt/</string>
    <string name="onboarding_p1_meaning">Stubborn courage — the will to keep going.</string>

    <string name="onboarding_p2_title">Morning, with a purpose</string>
    <string name="onboarding_p2_body">A short quiz at the time you set, built from what you saved. Answer it and your phone gets out of the way.</string>
    <string name="onboarding_p2_question">In this line, what does “grit” mean?</string>
    <string name="onboarding_p2_option_a">Small stones on a beach</string>
    <string name="onboarding_p2_option_b">Stubborn courage</string>
    <string name="onboarding_p2_option_c">A kind of film camera</string>
    <string name="onboarding_p2_option_d">A short musical note</string>
    <string name="onboarding_p2_correct">Right — stubborn courage.</string>
    <string name="onboarding_p2_wrong">Not quite. Here it means stubborn courage.</string>

    <string name="onboarding_p3_title">Only what you allow</string>
    <string name="onboarding_p3_body">Your cards, reviews and captured media stay on this device. There is no account and no analytics. Nothing leaves your phone unless you choose an online dictionary lookup.</string>
    <string name="onboarding_p3_screen_title">Screen capture</string>
    <string name="onboarding_p3_screen_body">Reads a single frame when you capture a line, then stops.</string>
    <string name="onboarding_p3_mic_title">Microphone</string>
    <string name="onboarding_p3_mic_body">Records a clip only while you hold a capture session.</string>
    <string name="onboarding_p3_notif_title">Notifications</string>
    <string name="onboarding_p3_notif_body">Keeps the floating capture control visible and delivers the morning quiz.</string>
    <string name="onboarding_p3_footnote">Every one of these can be turned off later, and the app keeps working.</string>

    <string name="onboarding_permission_title">One last thing</string>
    <string name="onboarding_permission_body">ReelVocab keeps everything on this phone: your cards, reviews and captured media. Android will ask for screen capture the first time you tap the floating pill.</string>
    <string name="onboarding_permission_overlay">To make the floating capture pill work over other apps, allow “Display over other apps”.</string>
    <string name="onboarding_permission_allow">Allow overlay</string>
    <string name="onboarding_permission_later">Not now</string>

